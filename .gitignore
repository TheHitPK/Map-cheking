/out/
*.class
.idea/
*.iml

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
*.g.dart.bak

# Map / routing data (large, generated)
*.osm.pbf
!backend/src/test/resources/osm/*.osm.pbf
*.pmtiles
!app/assets/maps/maracaibo.pmtiles
graph-cache/

# OS
.DS_Store
Thumbs.db

# OSM downloads
data/*
!data/maracaibo.osm.pbf

